---
const featuredCourses = [
  [
    'Omics 101 Series',
    'Foundational courses introducing genomics, transcriptomics, proteomics, metabolomics, lipidomics, epigenomics, and microbiomics.',
    '/online/courses',
  ],
  [
    'Graduate Certificate Pathways',
    'Advanced academic pathways connecting omics sciences, AI, biotechnology, and translational innovation.',
    '/online/courses',
  ],
  [
    'Narrated Lessons',
    'Structured lesson experiences with presentation, audio, and transcript-based learning.',
    '/online/lessons',
  ],
];

const pillars = [
  [
    'Academic Quality',
    'Graduate-level scientific content designed with clarity, depth, and strong conceptual structure.',
  ],
  [
    'Flexible Learning',
    'Self-paced and modular learning experiences designed for modern students and working professionals.',
  ],
  [
    'Applied Learning',
    'Lessons built around scientific reasoning, interpretation, and real-world omics applications.',
  ],
  [
    'Career Engagement',
    'Learning pathways that support scientific communication, digital credentials, and workforce development.',
  ],
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PanorOmics Online</title>

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    body{
      font-family:Inter,sans-serif;
      background:#f4f1ea;
      color:#2f2a26;
    }

    .container{
      max-width:1200px;
      margin:auto;
      padding:72px 7% 80px;
    }

    .back{
      color:#8C1515;
      text-decoration:none;
      font-size:.9rem;
      font-weight:700;
    }

    .hero{
      margin-top:28px;
      padding:48px;
      border-radius:30px;
      background:linear-gradient(135deg,#fffdfa 0%, #efe8dd 100%);
      border:1px solid rgba(140,21,21,.10);
      box-shadow:0 16px 40px rgba(0,0,0,.05);
    }

    .hero-kicker{
      color:#8C1515;
      font-size:.78rem;
      font-weight:800;
      letter-spacing:.16em;
      text-transform:uppercase;
      margin-bottom:16px;
    }

    .hero h1{
      font-size:clamp(2.5rem,5vw,4.8rem);
      line-height:.95;
      letter-spacing:-.05em;
      color:#2f2a26;
      margin-bottom:18px;
    }

    .hero h1 span{
      color:#8C1515;
    }

    .hero p{
      max-width:860px;
      color:#5c5650;
      line-height:1.8;
      font-size:1rem;
    }

    .hero-actions{
      display:flex;
      flex-wrap:wrap;
      gap:14px;
      margin-top:28px;
    }

    .primary-button,
    .secondary-button{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:14px 26px;
      border-radius:999px;
      text-decoration:none;
      font-weight:800;
      transition:.25s ease;
    }

    .primary-button{
      background:#8C1515;
      color:#fff;
    }

    .primary-button:hover{
      background:#6F1111;
      transform:translateY(-2px);
    }

    .secondary-button{
      border:1px solid rgba(140,21,21,.20);
      color:#8C1515;
      background:#fffdfa;
    }

    .secondary-button:hover{
      background:#f9f3ea;
      transform:translateY(-2px);
    }

    .section{
      margin-top:64px;
    }

    .section h2{
      font-size:2rem;
      margin-bottom:14px;
      letter-spacing:-.03em;
      color:#2f2a26;
    }

    .section h2 span{
      color:#8C1515;
    }

    .section p{
      max-width:820px;
      color:#5c5650;
      line-height:1.8;
    }

    .grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
      gap:20px;
      margin-top:24px;
    }

    .card{
      background:#fffdfa;
      border:1px solid rgba(140,21,21,.10);
      border-radius:22px;
      padding:24px;
      text-decoration:none;
      box-shadow:0 10px 28px rgba(0,0,0,.04);
      transition:.25s ease;
    }

    .card:hover{
      transform:translateY(-4px);
      border-color:rgba(140,21,21,.24);
    }

    .card h3{
      color:#8C1515;
      font-size:1.08rem;
      margin-bottom:10px;
    }

    .card p{
      color:#5c5650;
      font-size:.94rem;
      line-height:1.7;
    }

    .band{
      margin-top:64px;
      padding:34px 30px;
      border-radius:24px;
      background:#8C1515;
      color:#fff;
    }

    .band h2{
      color:#fff;
      margin-bottom:10px;
    }

    .band p{
      color:rgba(255,255,255,.88);
      max-width:780px;
    }

    .footer-note{
      margin-top:40px;
      color:#7a736c;
      font-size:.9rem;
    }

    @media(max-width:768px){
      .container{
        padding:56px 18px 64px;
      }

      .hero{
        padding:30px 22px;
      }

      .hero-actions{
        flex-direction:column;
      }

      .primary-button,
      .secondary-button{
        width:100%;
      }
    }
  </style>
</head>
<body>

  <main class="container">

    <a href="/" class="back">← Back to PanorOmics</a>

    <section class="hero">
      <div class="hero-kicker">PanorOmics Online</div>
      <h1>Education <span>Without Boundaries</span></h1>
      <p>
        PanorOmics Online is the learning environment for narrated lessons, courses, certificates,
        and professional development in Omics Sciences, biotechnology, artificial intelligence,
        and translational innovation.
      </p>

      <div class="hero-actions">
        <a href="/online/courses" class="primary-button">Explore Courses</a>
        <a href="/online/lessons" class="secondary-button">Browse Lessons</a>
      </div>
    </section>

    <section class="section">
      <h2>Learning <span>Pathways</span></h2>
      <p>
        Build from foundational Omics 101 lessons to advanced graduate-level learning experiences,
        certificate pathways, and career-focused scientific education.
      </p>

      <div class="grid">
        {featuredCourses.map(([title, text, href]) => (
          <a href={href} class="card">
            <h3>{title}</h3>
            <p>{text}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <h2>Educational <span>Pillars</span></h2>
      <p>
        PanorOmics Online is designed to combine scientific rigor, flexible access, applied learning,
        and professional relevance.
      </p>

      <div class="grid">
        {pillars.map(([title, text]) => (
          <div class="card">
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="band">
      <h2>Start with Omics 101</h2>
      <p>
        Begin with foundational courses in genomics, transcriptomics, proteomics, metabolomics,
        lipidomics, epigenomics, and microbiomics, then continue into advanced certificate and
        applied biotechnology pathways.
      </p>
    </section>

    <div class="footer-note">
      PanorOmics Online is the education portal powered by PanED.
    </div>

  </main>

</body>
</html>
