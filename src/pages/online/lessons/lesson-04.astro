---
const lesson = {
  number: 'Lesson 4',
  title: 'Creating and Using Graphics',
  instructor: 'Diane Caporale',
  duration: '~29 Minutes',
  coverImage: '/lessons/lesson-04/cover.png',
  audioFile: '/lessons/lesson-04/audio.mp3',
  transcriptFile: '/lessons/lesson-04/transcript.pdf',
  transcriptText: `
This is the lesson transcript preview.

Replace this text with the full transcript, summary,
or introduction for the lesson.

You can also remove this block entirely if you only
want to provide a downloadable transcript file.
  `.trim(),
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{lesson.number} | {lesson.title} | PanorOmics Online</title>

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    body{
      font-family:Inter,sans-serif;
      background:#f4f1ea;
      color:#2f2a26;
      min-height:100vh;
    }

    .page{
      max-width:1200px;
      margin:0 auto;
      padding:56px 24px 80px;
    }

    .eyebrow{
      color:#8C1515;
      font-size:.82rem;
      font-weight:800;
      letter-spacing:.16em;
      text-transform:uppercase;
      margin-bottom:14px;
    }

    .page-title{
      font-size:clamp(2.2rem,5vw,4.5rem);
      font-weight:300;
      line-height:1.02;
      letter-spacing:-0.05em;
      color:#5b5854;
      margin-bottom:34px;
    }

    .lesson-shell{
      display:grid;
      grid-template-columns:minmax(320px, 840px) minmax(280px, 1fr);
      gap:28px;
      align-items:start;
    }

    .lesson-card{
      position:relative;
      overflow:hidden;
      border-radius:30px;
      min-height:760px;
      background:#6f35a7;
      border:1px solid rgba(0,0,0,.08);
      box-shadow:0 18px 45px rgba(77,47,110,.18);
      display:flex;
      align-items:center;
      justify-content:center;
      padding:42px;
      isolation:isolate;
    }

    .lesson-card::before{
      content:"";
      position:absolute;
      inset:0;
      background:
        linear-gradient(135deg, rgba(255,255,255,.08), transparent 40%),
        radial-gradient(circle at 18% 18%, rgba(255,255,255,.08), transparent 28%),
        radial-gradient(circle at 80% 78%, rgba(255,255,255,.08), transparent 24%);
      z-index:0;
    }

    .lesson-bg{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      object-fit:cover;
      opacity:.18;
      z-index:0;
    }

    .lesson-inner{
      position:relative;
      z-index:1;
      width:min(100%, 760px);
      background:rgba(244, 241, 234, .82);
      backdrop-filter:blur(8px);
      border-radius:22px;
      padding:40px 36px 30px;
      text-align:center;
      box-shadow:0 8px 24px rgba(0,0,0,.08);
    }

    .lesson-name{
      font-size:clamp(2rem,4vw,3.5rem);
      line-height:1.08;
      font-weight:800;
      letter-spacing:-0.04em;
      color:#131313;
      margin-bottom:28px;
    }

    .lesson-meta{
      font-size:1.2rem;
      color:#1f1f1f;
      line-height:1.6;
      margin-bottom:30px;
    }

    .lesson-meta .duration{
      margin-top:18px;
      display:block;
      font-size:1.15rem;
    }

    .start-button{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-width:220px;
      padding:18px 34px;
      border-radius:999px;
      background:#8C1515;
      color:#fff;
      text-decoration:none;
      font-size:1.2rem;
      font-weight:800;
      border:none;
      cursor:pointer;
      transition:.25s ease;
      margin-bottom:28px;
    }

    .start-button:hover{
      background:#6f1111;
      transform:translateY(-2px);
    }

    .resource-buttons{
      display:flex;
      flex-direction:column;
      gap:12px;
      width:min(100%, 560px);
      margin:0 auto;
    }

    .resource-button{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:12px;
      padding:14px 18px;
      border-radius:14px;
      text-decoration:none;
      font-size:1rem;
      font-weight:700;
      transition:.25s ease;
    }

    .resource-button.audio{
      color:#2f2a26;
      background:transparent;
      border:none;
    }

    .resource-button.audio:hover{
      color:#8C1515;
    }

    .resource-button.transcript{
      color:#2f2a26;
      background:transparent;
      border:1.5px dashed rgba(140,21,21,.35);
    }

    .resource-button.transcript:hover{
      border-color:#8C1515;
      color:#8C1515;
      background:rgba(140,21,21,.04);
    }

    .sidebar{
      display:flex;
      flex-direction:column;
      gap:18px;
    }

    .panel{
      background:#fffdfa;
      border:1px solid rgba(140,21,21,.10);
      border-radius:22px;
      padding:22px;
      box-shadow:0 8px 24px rgba(0,0,0,.04);
    }

    .panel h2{
      font-size:1.1rem;
      color:#8C1515;
      margin-bottom:12px;
    }

    .panel p{
      line-height:1.65;
      color:#544f49;
      font-size:.96rem;
    }

    .audio-player{
      width:100%;
      margin-top:10px;
    }

    .transcript-box{
      margin-top:10px;
      padding:16px;
      border-radius:16px;
      background:#f8f4ee;
      color:#534f49;
      font-size:.94rem;
      line-height:1.7;
      white-space:pre-wrap;
      max-height:320px;
      overflow:auto;
    }

    .back-link{
      display:inline-flex;
      align-items:center;
      gap:8px;
      text-decoration:none;
      color:#8C1515;
      font-weight:700;
      margin-bottom:22px;
    }

    @media(max-width:1000px){
      .lesson-shell{
        grid-template-columns:1fr;
      }

      .lesson-card{
        min-height:640px;
      }
    }

    @media(max-width:640px){
      .page{
        padding:34px 16px 50px;
      }

      .lesson-card{
        padding:18px;
        border-radius:24px;
        min-height:560px;
      }

      .lesson-inner{
        padding:28px 20px 24px;
      }

      .lesson-meta{
        font-size:1.05rem;
      }

      .start-button{
        width:100%;
        min-width:0;
      }
    }
  </style>
</head>

<body>
  <main class="page">
    <a href="/education" class="back-link">← Back to PanorOmics Online</a>

    <div class="eyebrow">PanorOmics Online Narrated Lesson</div>

    <h1 class="page-title">
      {lesson.number} Narrated<br />
      Presentation
    </h1>

    <section class="lesson-shell">
      <div class="lesson-card">
        <img
          src={lesson.coverImage}
          alt={lesson.title}
          class="lesson-bg"
        />

        <div class="lesson-inner">
          <h2 class="lesson-name">{lesson.title}</h2>

          <div class="lesson-meta">
            <div>{lesson.instructor}</div>
            <span class="duration">{lesson.duration}</span>
          </div>

          <button class="start-button" id="startLesson">
            Start
          </button>

          <div class="resource-buttons">
            <a
              href={lesson.audioFile}
              class="resource-button audio"
              target="_blank"
              rel="noopener noreferrer"
            >
              ⤓ Audio
            </a>

            <a
              href={lesson.transcriptFile}
              class="resource-button transcript"
              target="_blank"
              rel="noopener noreferrer"
            >
              ⤓ Transcript
            </a>
          </div>
        </div>
      </div>

      <aside class="sidebar">
        <div class="panel">
          <h2>Lesson Audio</h2>
          <p>Play narration directly from the lesson page.</p>
          <audio controls class="audio-player" id="lessonAudio">
            <source src={lesson.audioFile} type="audio/mpeg" />
          </audio>
        </div>

        <div class="panel">
          <h2>Transcript Preview</h2>
          <p>Use this space for a full transcript, preview, or lesson summary.</p>
          <div class="transcript-box">{lesson.transcriptText}</div>
        </div>
      </aside>
    </section>
  </main>

  <script is:inline>
    const startButton = document.getElementById('startLesson');
    const lessonAudio = document.getElementById('lessonAudio');

    startButton?.addEventListener('click', () => {
      if (lessonAudio) {
        lessonAudio.play().catch(() => {});
        lessonAudio.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  </script>
</body>
</html>
