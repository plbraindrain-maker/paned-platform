---
const lessonGroups = [
  [
    'Narrated Lessons',
    'Presentation-style lessons with structured visuals, audio narration, and transcript support.',
    [
      'Introduction to Omics Sciences',
      'Foundations of Genomics',
      'Understanding Transcriptomics',
      'Reading Scientific Graphics',
    ],
  ],
  [
    'Lesson Features',
    'PanorOmics Online lessons are designed for flexible, guided, multimedia learning.',
    [
      'Slide-based presentation flow',
      'Integrated audio narration',
      'Transcript access',
      'Mobile-friendly lesson viewing',
    ],
  ],
];

const highlights = [
  [
    'Narrated Presentations',
    'Each lesson can combine slide visuals, voice narration, and structured pacing.',
  ],
  [
    'Transcript Access',
    'Learners can review key concepts through downloadable or embedded transcripts.',
  ],
  [
    'Flexible Review',
    'Lessons support self-paced review and repeated listening for concept reinforcement.',
  ],
  [
    'Professional Design',
    'Visual learning experiences are designed to feel academic, modern, and easy to navigate.',
  ],
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lessons | PanorOmics Online</title>

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    body{
      font-family:Inter,sans-serif;
      background:#f4f1ea;
      color:#2f2a26;
    }

    .container{
      max-width:1200px;
      margin:auto;
      padding:72px 7% 80px;
    }

    .back{
      color:#8C1515;
      text-decoration:none;
      font-size:.9rem;
      font-weight:700;
    }

    .hero{
      margin-top:28px;
      padding:48px;
      border-radius:30px;
      background:linear-gradient(135deg,#fffdfa 0%, #efe8dd 100%);
      border:1px solid rgba(140,21,21,.10);
      box-shadow:0 16px 40px rgba(0,0,0,.05);
    }

    .hero-kicker{
      color:#8C1515;
      font-size:.78rem;
      font-weight:800;
      letter-spacing:.16em;
      text-transform:uppercase;
      margin-bottom:16px;
    }

    .hero h1{
      font-size:clamp(2.4rem,5vw,4.6rem);
      line-height:.96;
      letter-spacing:-.05em;
      color:#2f2a26;
      margin-bottom:18px;
    }

    .hero h1 span{
      color:#8C1515;
    }

    .hero p{
      max-width:860px;
      color:#5c5650;
      line-height:1.8;
      font-size:1rem;
    }

    .section{
      margin-top:64px;
    }

    .section h2{
      font-size:2rem;
      margin-bottom:14px;
      letter-spacing:-.03em;
      color:#2f2a26;
    }

    .section h2 span{
      color:#8C1515;
    }

    .section p{
      max-width:820px;
      color:#5c5650;
      line-height:1.8;
    }

    .grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
      gap:20px;
      margin-top:24px;
    }

    .card{
      background:#fffdfa;
      border:1px solid rgba(140,21,21,.10);
      border-radius:22px;
      padding:24px;
      box-shadow:0 10px 28px rgba(0,0,0,.04);
    }

    .card h3{
      color:#8C1515;
      font-size:1.08rem;
      margin-bottom:10px;
    }

    .card p{
      color:#5c5650;
      font-size:.94rem;
      line-height:1.7;
    }

    .stack{
      display:grid;
      gap:20px;
      margin-top:24px;
    }

    .lesson-group{
      background:#fffdfa;
      border:1px solid rgba(140,21,21,.10);
      border-radius:24px;
      padding:28px;
      box-shadow:0 10px 28px rgba(0,0,0,.04);
    }

    .lesson-group h3{
      color:#8C1515;
      font-size:1.18rem;
      margin-bottom:10px;
    }

    .lesson-group p{
      color:#5c5650;
      line-height:1.75;
      margin-bottom:16px;
    }

    .lesson-list{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
      gap:12px;
      list-style:none;
      padding:0;
      margin:0;
    }

    .lesson-list li{
      background:#f9f3ea;
      border:1px solid rgba(140,21,21,.08);
      border-radius:16px;
      padding:14px 16px;
      color:#433d38;
      font-size:.92rem;
      font-weight:700;
    }

    .band{
      margin-top:64px;
      padding:34px 30px;
      border-radius:24px;
      background:#8C1515;
      color:#fff;
    }

    .band h2{
      color:#fff;
      margin-bottom:10px;
      font-size:1.8rem;
    }

    .band p{
      color:rgba(255,255,255,.88);
      max-width:780px;
      line-height:1.8;
    }

    .button-row{
      display:flex;
      flex-wrap:wrap;
      gap:14px;
      margin-top:24px;
    }

    .primary-button,
    .secondary-button{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:14px 26px;
      border-radius:999px;
      text-decoration:none;
      font-weight:800;
      transition:.25s ease;
    }

    .primary-button{
      background:#fff;
      color:#8C1515;
    }

    .primary-button:hover{
      transform:translateY(-2px);
      background:#f9f3ea;
    }

    .secondary-button{
      border:1px solid rgba(255,255,255,.26);
      color:#fff;
      background:transparent;
    }

    .secondary-button:hover{
      transform:translateY(-2px);
      background:rgba(255,255,255,.08);
    }

    @media(max-width:768px){
      .container{
        padding:56px 18px 64px;
      }

      .hero{
        padding:30px 22px;
      }

      .button-row{
        flex-direction:column;
      }

      .primary-button,
      .secondary-button{
        width:100%;
      }
    }
  </style>
</head>
<body>

  <main class="container">

    <a href="/online" class="back">← Back to PanorOmics Online</a>

    <section class="hero">
      <div class="hero-kicker">PanorOmics Online Lessons</div>
      <h1>Narrated <span>Lessons</span></h1>
      <p>
        Explore structured lesson experiences designed for visual, narrated, and transcript-supported learning.
        PanorOmics Online lessons bring together academic presentation design, flexible pacing, and accessible review.
      </p>
    </section>

    <section class="section">
      <h2>Lesson <span>Highlights</span></h2>
      <p>
        Narrated lessons are designed to support understanding, review, and flexible learning across scientific topics.
      </p>

      <div class="grid">
        {highlights.map(([title, text]) => (
          <div class="card">
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <h2>Lesson <span>Collections</span></h2>
      <p>
        Organize lessons into thematic groups, course modules, or narrated presentation series.
      </p>

      <div class="stack">
        {lessonGroups.map(([title, text, items]) => (
          <div class="lesson-group">
            <h3>{title}</h3>
            <p>{text}</p>

            <ul class="lesson-list">
              {items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="band">
      <h2>Build from Lessons to Courses</h2>
      <p>
        Use narrated lessons as the building blocks for full course pathways, modular scientific education,
        and future certificate-based learning experiences.
      </p>

      <div class="button-row">
        <a href="/online/courses" class="primary-button">Explore Courses</a>
        <a href="/online" class="secondary-button">Back to Online Home</a>
      </div>
    </section>

  </main>

</body>
</html>
