---
const courseGroups = [ 
  [
    'Omics 101 Series',
    'Foundational courses introducing the major omics sciences through structured, accessible, and visually engaging learning.',
    [
      'Genomics 101',
      'Transcriptomics 101',
      'Proteomics 101',
      'Metabolomics 101',
      'Lipidomics 101',
      'Epigenomics 101',
      'Microbiomics 101',
    ],
  ],
  [
    'Advanced Omics Sciences',
    'Graduate-level courses that deepen scientific reasoning, translational strategy, and systems-level understanding.',
    [
      'OSC-710 Genomics',
      'OSC-711 Transcriptomics',
      'OSC-712 Proteomics',
      'OSC-713 Metabolomics',
      'OSC-714 Epigenomics',
      'OSC-716 Lipidomics',
      'OSC-717 Microbiomics',
    ],
  ],
  [
    'Translation, AI & Innovation',
    'Courses connecting omics sciences with artificial intelligence, translational research, regulation, and biotechnology entrepreneurship.',
    [
      'OSC-751 Translational Omics Research',
      'OSC-752 AI and Computational Biology',
      'OSC-753 Regulatory Affairs and Clinical Validation',
      'OSC-754 Biotechnology Entrepreneurship',
      'OSC-755 Biotechnology Innovation Capstone',
    ],
  ],
];

const highlights = [
  [
    'Narrated Lessons',
    'Structured lesson experiences combining visual presentation, audio, and transcript-based learning.',
  ],
  [
    'Flexible Learning',
    'Self-paced access designed for modern learners, scientists, and working professionals.',
  ],
  [
    'Career Relevance',
    'Learning pathways designed to support scientific communication, translational thinking, and workforce growth.',
  ],
  [
    'Academic Rigor',
    'Content built with scientific depth, conceptual clarity, and graduate-level educational intent.',
  ],
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Courses | PanorOmics Online</title>

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    body{
      font-family:Inter,sans-serif;
      background:#f4f1ea;
      color:#2f2a26;
    }

    .container{
      max-width:1200px;
      margin:auto;
      padding:72px 7% 80px;
    }

    .back{
      color:#8C1515;
      text-decoration:none;
      font-size:.9rem;
      font-weight:700;
    }

    .hero{
      margin-top:28px;
      padding:48px;
      border-radius:30px;
      background:linear-gradient(135deg,#fffdfa 0%, #efe8dd 100%);
      border:1px solid rgba(140,21,21,.10);
      box-shadow:0 16px 40px rgba(0,0,0,.05);
    }

    .hero-kicker{
      color:#8C1515;
      font-size:.78rem;
      font-weight:800;
      letter-spacing:.16em;
      text-transform:uppercase;
      margin-bottom:16px;
    }

    .hero h1{
      font-size:clamp(2.4rem,5vw,4.6rem);
      line-height:.96;
      letter-spacing:-.05em;
      color:#2f2a26;
      margin-bottom:18px;
    }

    .hero h1 span{
      color:#8C1515;
    }

    .hero p{
      max-width:860px;
      color:#5c5650;
      line-height:1.8;
      font-size:1rem;
    }

    .section{
      margin-top:64px;
    }

    .section h2{
      font-size:2rem;
      margin-bottom:14px;
      letter-spacing:-.03em;
      color:#2f2a26;
    }

    .section h2 span{
      color:#8C1515;
    }

    .section p{
      max-width:820px;
      color:#5c5650;
      line-height:1.8;
    }

    .grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
      gap:20px;
      margin-top:24px;
    }

    .card{
      background:#fffdfa;
      border:1px solid rgba(140,21,21,.10);
      border-radius:22px;
      padding:24px;
      box-shadow:0 10px 28px rgba(0,0,0,.04);
    }

    .card h3{
      color:#8C1515;
      font-size:1.08rem;
      margin-bottom:10px;
    }

    .card p{
      color:#5c5650;
      font-size:.94rem;
      line-height:1.7;
    }

    .stack{
      display:grid;
      gap:20px;
      margin-top:24px;
    }

    .course-group{
      background:#fffdfa;
      border:1px solid rgba(140,21,21,.10);
      border-radius:24px;
      padding:28px;
      box-shadow:0 10px 28px rgba(0,0,0,.04);
    }

    .course-group h3{
      color:#8C1515;
      font-size:1.18rem;
      margin-bottom:10px;
    }

    .course-group p{
      color:#5c5650;
      line-height:1.75;
      margin-bottom:16px;
    }

    .course-list{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
      gap:12px;
      list-style:none;
      padding:0;
      margin:0;
    }

    .course-list li{
      background:#f9f3ea;
      border:1px solid rgba(140,21,21,.08);
      border-radius:16px;
      padding:14px 16px;
      color:#433d38;
      font-size:.92rem;
      font-weight:700;
    }

    .band{
      margin-top:64px;
      padding:34px 30px;
      border-radius:24px;
      background:#8C1515;
      color:#fff;
    }

    .band h2{
      color:#fff;
      margin-bottom:10px;
      font-size:1.8rem;
    }

    .band p{
      color:rgba(255,255,255,.88);
      max-width:780px;
      line-height:1.8;
    }

    .button-row{
      display:flex;
      flex-wrap:wrap;
      gap:14px;
      margin-top:24px;
    }

    .primary-button,
    .secondary-button{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:14px 26px;
      border-radius:999px;
      text-decoration:none;
      font-weight:800;
      transition:.25s ease;
    }

    .primary-button{
      background:#fff;
      color:#8C1515;
    }

    .primary-button:hover{
      transform:translateY(-2px);
      background:#f9f3ea;
    }

    .secondary-button{
      border:1px solid rgba(255,255,255,.26);
      color:#fff;
      background:transparent;
    }

    .secondary-button:hover{
      transform:translateY(-2px);
      background:rgba(255,255,255,.08);
    }

    @media(max-width:768px){
      .container{
        padding:56px 18px 64px;
      }

      .hero{
        padding:30px 22px;
      }

      .button-row{
        flex-direction:column;
      }

      .primary-button,
      .secondary-button{
        width:100%;
      }
    }
  </style>
</head>
<body>

  <main class="container">

    <a href="/online" class="back">← Back to PanorOmics Online</a>

    <section class="hero">
      <div class="hero-kicker">PanorOmics Online Courses</div>
      <h1>Course <span>Pathways</span></h1>
      <p>
        Explore foundational, advanced, and translational learning experiences in Omics Sciences,
        biotechnology, artificial intelligence, and innovation. PanorOmics Online is designed to
        move learners from scientific understanding to applied academic and professional growth.
      </p>
    </section>

    <section class="section">
      <h2>Course <span>Highlights</span></h2>
      <p>
        Courses are designed to support both scientific depth and practical educational flexibility.
      </p>

      <div class="grid">
        {highlights.map(([title, text]) => (
          <div class="card">
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <h2>Learning <span>Tracks</span></h2>
      <p>
        PanorOmics Online organizes courses into clear tracks that support beginner entry, advanced study,
        and translational application.
      </p>

      <div class="stack">
        {courseGroups.map(([title, text, items]) => (
          <div class="course-group">
            <h3>{title}</h3>
            <p>{text}</p>

            <ul class="course-list">
              {items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="band">
      <h2>Begin with Omics 101</h2>
      <p>
        Start with foundational narrated lessons and build toward advanced omics sciences, AI-integrated biology,
        and translational biotechnology pathways.
      </p>

      <div class="button-row">
        <a href="/online/lessons" class="primary-button">Browse Lessons</a>
        <a href="/online" class="secondary-button">Back to Online Home</a>
      </div>
    </section>

  </main>

</body>
</html>
